# Copie para .env na raiz do repositório (apps e scripts leem daqui).

# Banco de dados
# Local: `pnpm db:up`. Supabase (projeto em us-east-1, junto com a Vercel em iad1):
# - DATABASE_URL: pooler em modo transação (porta 6543) — usado pelos apps na Vercel
# - DATABASE_URL_DIRECT: pooler em modo sessão (porta 5432) — usada só pelas migrações (vazia = usa DATABASE_URL)
# - DATABASE_SSL_CA: certificado SSL da Supabase (Database Settings → SSL), em uma linha com \n
# - DATABASE_POOL_MAX: 5 na Vercel (cada instância abre poucas conexões)
DATABASE_URL=postgres://forja:forja@localhost:5432/forja
DATABASE_URL_DIRECT=
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10

# Chave mestra para criptografar chaves de API e credenciais de conectores.
# Gere com: pnpm gen:key  (32 bytes em base64). NUNCA reutilize entre ambientes.
ENCRYPTION_KEY=

# Autenticação (Better Auth). Gere o segredo com: pnpm gen:key
BETTER_AUTH_SECRET=
# Na Vercel são opcionais: sem elas, cada app usa o próprio domínio de produção.
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Conta inicial do painel do dono (criada pelo seed com papel "staff").
# No primeiro acesso o painel exige ativar o 2FA. Troque a senha depois.
ADMIN_EMAIL=voce@suaempresa.com.br
ADMIN_PASSWORD=troque-esta-senha
# Opcional: só estes IPs acessam o painel (separados por vírgula)
ADMIN_IP_ALLOWLIST=

# Opcional: login com GitHub (github.com/settings/developers → OAuth App)
# Callback: {WEB_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-mail transacional pelo Microsoft 365 (Microsoft Graph, ver docs/05-microsoft-365-email.md).
# Sem essas variáveis, em desenvolvimento os e-mails aparecem no terminal.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Caixa remetente (caixa compartilhada, sem licença), ex.: nao-responda@suaempresa.com.br
EMAIL_FROM=

# Só no seu computador: cria a conta demo (demo@forja.dev / demo12345) no `pnpm db:seed`.
# Nunca defina isto na Vercel (o seed ignora a flag lá de qualquer forma).
SEED_DEMO=1
# O seed só cria planos que faltam (edições do painel são preservadas). =1 reaplica os planos do código.
SEED_RESET_PLANS=

# Nome provisório do produto
NEXT_PUBLIC_APP_NAME=Forja

# Opcional em desenvolvimento: chaves de provedores usadas pelo seed
# (em produção elas são cadastradas no painel do dono, criptografadas no banco).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
